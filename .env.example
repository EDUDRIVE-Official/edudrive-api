APP_NAME=EDUDRIVE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Canal de alertas por Slack para errores criticos. Solo se activa si esta
# variable esta seteada (ver config/logging.php); tipicamente configurado
# en QA/Staging/Produccion, no en Local/Desarrollo.
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_LEVEL=critical

# Este proyecto corre sobre Docker Compose (ver compose.yaml) con Postgres,
# Redis, MinIO y Mailpit como servicios locales.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=edudrive
DB_USERNAME=edudrive
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@edudrive.cr"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=edudrive-files
AWS_URL=http://localhost:9100/edudrive-files
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Origenes permitidos para CORS (lista separada por comas). "*" es solo
# apropiado en Local/Desarrollo; en QA/Staging/Produccion debe restringirse
# a los dominios reales de los clientes autorizados (ver config/cors.php y
# docs/operaciones/ambientes.md).
CORS_ALLOWED_ORIGINS=*

VITE_APP_NAME="${APP_NAME}"
