# Plantilla de entorno de produccion para el despliegue en un unico VPS.
# Ver docs/operaciones/despliegue-vps.md.
#
# Copiar como ".env" en el servidor (nunca commitear el .env real) y
# completar los valores en blanco antes del primer "docker compose up".
# "RequiredSecretsValidator" (Modules\Foundation) rechaza el arranque de
# la aplicacion si falta alguno de los marcados como obligatorio.

APP_NAME=EDUDRIVE
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_DOMAIN=app.edudrive.vr506.com
APP_URL=https://app.edudrive.vr506.com
PILOT_INSTRUMENTS_ENABLED=false

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Usada por compose.prod.yaml para elegir el tag de imagen a desplegar.
# El runbook de despliegue (docs/operaciones/ci-cd.md) usa el SHA corto
# del commit, nunca "latest", para que el despliegue sea reproducible.
IMAGE_TAG=latest

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=edudrive
DB_USERNAME=edudrive
# Obligatoria. Generar una contraseña real, ej.: openssl rand -base64 32
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis

# Almacenamiento de archivos (S3-compatible). Por defecto apunta al MinIO
# incluido en compose.prod.yaml, corriendo en el mismo VPS. Las mismas
# credenciales configuran tanto Laravel como el propio contenedor de MinIO.
FILESYSTEM_DISK=s3
# Obligatorias.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=edudrive
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Entrega transaccional. El token corresponde al Server API Token del
# servidor EduDrive en Postmark y nunca debe entrar al repositorio.
MAIL_MAILER=postmark
POSTMARK_API_KEY=
MAIL_FROM_ADDRESS=noreply@edudrive.vr506.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_DELIVERY_MODE=external

# En produccion nunca debe ser "*".
CORS_ALLOWED_ORIGINS=https://app.edudrive.vr506.com
